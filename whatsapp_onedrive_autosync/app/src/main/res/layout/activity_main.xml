<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WhatsApp to OneDrive Auto-Sync"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checking status..."
        android:textSize="16sp"
        android:padding="16dp"
        android:background="#E8F5E9"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnEnableNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Enable WhatsApp Reader Access"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnGrantStorage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Grant Storage Access"
        android:layout_marginBottom="12dp" />

</LinearLayout>
